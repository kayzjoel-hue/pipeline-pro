# Database Configuration
# MySQL connection string for Drizzle ORM
DATABASE_URL=mysql://user:password@localhost:3306/pipeline_pro

# Backend Server
# Port for local development (auto-finds available port if taken)
PORT=3000

# Frontend Configuration
# API endpoint - points to backend tRPC router
# Local development:
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/trpc
# Production (Railway backend):
# EXPO_PUBLIC_API_BASE_URL=https://your-backend.railway.app/api/trpc

# OAuth / Authentication
# Configure OAuth providers for login flow (if needed)
# OAUTH_PROVIDER_CLIENT_ID=...
# OAUTH_PROVIDER_CLIENT_SECRET=...
# OAUTH_SERVER_URL=https://your-oauth-provider.example
# EXPO_PUBLIC_OAUTH_SERVER_URL=https://your-oauth-provider.example
# EXPO_PUBLIC_OAUTH_PORTAL_URL=https://your-oauth-portal.example

# Node Environment
NODE_ENV=development
# Set to 'production' when deploying
